# Configuration environment variables (optional overrides)
# Video source or camera RTSP stream
VIDEO_SOURCE=videos/sample_video.mp4

# RTSP Stream configuration example (Replace with your authenticated or local network stream)
# RTSP_STREAM_URL=rtsp://user:password@192.168.1.100:554/stream1

# Database path override
DATABASE_PATH=database/visitors.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
